    given-names: Sebastien
    email: sebastian.rousseau@gmail.com
version: "0.0.4"
date-released: "2026-08-29"
license: "Apache-2.0 OR MIT"
repository-code: "https://github.com/sebastienrousseau/structured-address-fix-mcp"
url: "https://sebastienrousseau.github.io/structured-address-fix/"
keywords:
  - ISO 20022
  - postal address
  - structured address
  - CBPR+
  - Model Context Protocol
  - MCP
  - AI agents
  - payments
